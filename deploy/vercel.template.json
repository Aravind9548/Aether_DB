{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://__BACKEND_HOST__/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://__BACKEND_HOST__/auth/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://__BACKEND_HOST__/oauth2/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://__BACKEND_HOST__/login/oauth2/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
